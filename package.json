{
  "name": "vitrine",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "start": "node start.ts",
    "demo": "node demo/start.ts",
    "warm-up": "node warm-up.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:report": "vite preview --outDir coverage",
    "test:e2e": "playwright test",
    "test:report": "vite preview --outDir vitest-report",
    "test:e2e:report": "vite preview --outDir playwright-report",
    "check": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "@astrojs/node": "^11.1.9",
    "astro": "^7.4.4",
    "gemoji": "^8.1.0",
    "ioredis": "^5.11.1",
    "marked": "^18.1.2",
    "sanitize-html": "^2.18.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

# Copy this file to .env, which git ignores. Vitrine reads it at start.
# These values only open the fake Sources of `npm run demo`: replace them to reach real ones.
GITLAB_TOKEN=demo-gitlab-token
HARBOR_PASSWORD=demo-harbor-password

# For a redis cache store. This is the server from compose.yaml.
REDIS_URL=redis://127.0.0.1:6379

# Any non-empty value, even false, stops Templates from Settings being compiled or run.
# VITRINE_TEMPLATE_DISABLE=1

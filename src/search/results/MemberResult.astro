---
import type { Member } from '../../sources/gitlab-api.ts';

interface Props {
	/** Left out when no Route shows the content, and the title is then no link. */
	url?: string;
	member: Member;
}

const { url, member } = Astro.props;
---

<div class="member">
	{member.avatarUrl ? <img src={member.avatarUrl} alt="" width="40" height="40" loading="lazy" /> : <span class="avatar" />}
	<div>
		<h2>{url ? <a href={url}>{member.name}</a> : member.name}</h2>
		<p>@{member.username}</p>
	</div>
</div>

<style>
	.member {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	img,
	.avatar {
		flex: none;
		width: 40px;
		height: 40px;
		border-radius: 50%;
	}

	.avatar {
		background: var(--color-border);
	}
</style>

---
import type { Issue } from '../../sources/gitlab-api.ts';

interface Props {
	/** Left out when no Route shows the content, and the title is then no link. */
	url?: string;
	issue: Issue;
}

const { url, issue } = Astro.props;
---

<h2>{url ? <a href={url}>{issue.title}</a> : issue.title}</h2>
<p>In <code>{issue.project}</code></p>
{issue.assignees.length > 0 && <p>Assigned to {issue.assignees.join(', ')}</p>}
{issue.labels.length > 0 && <p>Labels: {issue.labels.join(', ')}</p>}

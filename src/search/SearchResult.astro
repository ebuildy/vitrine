---
import type { Source } from '../settings.ts';
import EpicResult from './results/EpicResult.astro';
import GroupResult from './results/GroupResult.astro';
import ImageResult from './results/ImageResult.astro';
import IssueResult from './results/IssueResult.astro';
import MemberResult from './results/MemberResult.astro';
import ProjectResult from './results/ProjectResult.astro';
import type { SearchResult } from './search-engine.ts';

interface Props {
	result: SearchResult;
}

/** The colour of each kind of Source, so a Visitor tells them apart at a glance. A Nexus Source would be green. */
const SOURCE_COLOURS: Record<Source['type'], string> = {
	gitlab: '#fc6d26',
	harbor: '#1d6fd1',
};

const TYPE_NAMES = { group: 'Group', project: 'Project', issue: 'Issue', member: 'Member', epic: 'Epic', image: 'Image' } as const;

const { result } = Astro.props;
// The Source's own icon, beneath any path it is installed under. A Source that has none shows nothing, as the alt text is empty.
const icon = new URL('favicon.ico', result.sourceUrl.endsWith('/') ? result.sourceUrl : `${result.sourceUrl}/`).href;
---

<li class={`card search-result ${result.sourceType}`} style={{ '--source-colour': SOURCE_COLOURS[result.sourceType] }}>
	<p class="origin">
		<img src={icon} alt="" width="16" height="16" loading="lazy" referrerpolicy="no-referrer" />
		<span>{TYPE_NAMES[result.type]} in {result.source}</span>
		{result.stale && <span class="stale">Stale</span>}
	</p>
	{result.type === 'group' && <GroupResult url={result.url} group={result.group} />}
	{result.type === 'project' && <ProjectResult url={result.url} project={result.project} />}
	{result.type === 'issue' && <IssueResult url={result.url} issue={result.issue} />}
	{result.type === 'member' && <MemberResult url={result.url} member={result.member} />}
	{result.type === 'epic' && <EpicResult url={result.url} epic={result.epic} />}
	{result.type === 'image' && <ImageResult url={result.url} image={result.image} />}
</li>

<style>
	/* Two classes, so that the colour of the Source wins over the border of a Theme's cards. */
	.card.search-result {
		margin: 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--color-border);
		border-left: 0.35rem solid var(--source-colour);
		border-radius: 0.5rem;
		overflow-wrap: anywhere;
	}

	.card.search-result .origin {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0 0 0.25rem;
		color: var(--source-colour);
		font-size: 0.85rem;
		font-weight: bold;
	}

	.stale {
		margin-left: auto;
		font-weight: normal;
	}

	li :global(h2) {
		margin: 0;
		font-size: 1.1rem;
	}

	li :global(p) {
		margin: 0.25rem 0 0;
	}
</style>

---
import { SOURCE_LOOKS } from '../source-looks.ts';
import EpicResult from './results/EpicResult.astro';
import GroupResult from './results/GroupResult.astro';
import ImageResult from './results/ImageResult.astro';
import IssueResult from './results/IssueResult.astro';
import MemberResult from './results/MemberResult.astro';
import ProjectResult from './results/ProjectResult.astro';
import RepositoryResult from './results/RepositoryResult.astro';
import type { SearchResult } from './search-engine.ts';

interface Props {
	result: SearchResult;
}

const TYPE_NAMES = { group: 'Group', project: 'Project', issue: 'Issue', member: 'Member', epic: 'Epic', image: 'Image', repository: 'Repository' } as const;

const { result } = Astro.props;
const { colour, icon } = SOURCE_LOOKS[result.sourceType];
---

<li class={`card search-result ${result.sourceType}`} style={{ '--source-colour': colour }}>
	<p class="origin">
		<img src={icon} alt="" width="16" height="16" />
		<span>{TYPE_NAMES[result.type]} in {result.source}</span>
		{result.stale && <span class="stale">Stale</span>}
	</p>
	{result.type === 'group' && <GroupResult url={result.url} group={result.group} />}
	{result.type === 'project' && <ProjectResult url={result.url} project={result.project} />}
	{result.type === 'issue' && <IssueResult url={result.url} issue={result.issue} />}
	{result.type === 'member' && <MemberResult url={result.url} member={result.member} />}
	{result.type === 'epic' && <EpicResult url={result.url} epic={result.epic} />}
	{result.type === 'image' && <ImageResult url={result.url} image={result.image} />}
	{result.type === 'repository' && <RepositoryResult url={result.url} repository={result.repository} />}
</li>

<style>
	/* Two classes, so that the colour of the Source wins over the border of a Theme's cards. */
	.card.search-result {
		margin: 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--color-border);
		border-left: 0.35rem solid var(--source-colour);
		border-radius: 0.5rem;
		overflow-wrap: anywhere;
		position: relative;
	}

	/* Stretches the link of the title over its card, so that a click anywhere opens the result. */
	.card.search-result :global(h2 a::after) {
		content: '';
		position: absolute;
		inset: 0;
	}

	/* Every linked card lifts its border on hover, a Member's too, whose title sits deeper than a Theme looks. */
	.card.search-result:has(h2 a):hover {
		border-top-color: var(--color-primary);
		border-right-color: var(--color-primary);
		border-bottom-color: var(--color-primary);
	}

	.card.search-result .origin {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0 0 0.25rem;
		color: var(--source-colour);
		font-size: 0.85rem;
		font-weight: bold;
	}

	.stale {
		margin-left: auto;
		font-weight: normal;
	}

	li :global(h2) {
		margin: 0;
		font-size: 1.1rem;
	}

	li :global(p) {
		margin: 0.25rem 0 0;
	}
</style>

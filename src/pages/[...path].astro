---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { CachedContent } from '../content-cache.ts';
import GitlabGroup from '../controllers/GitlabGroup.astro';
import GitlabIssues from '../controllers/GitlabIssues.astro';
import GitlabProject from '../controllers/GitlabProject.astro';
import GitlabRoadmap from '../controllers/GitlabRoadmap.astro';
import Harbor from '../controllers/Harbor.astro';
import HarborImages from '../controllers/HarborImages.astro';
import Layout from '../layouts/Layout.astro';
import { matchRoute } from '../router.ts';
import type { ControllerName } from '../router.ts';
import { getGitlabSource, getSettings } from '../settings.ts';
import { getGroup, getMainGroup, getProject } from '../sources/gitlab.ts';

const controllers: Record<ControllerName, AstroComponentFactory> = {
	harbor: Harbor,
	'harbor-images': HarborImages,
	'gitlab-group': GitlabGroup,
	'gitlab-project': GitlabProject,
	'gitlab-roadmap': GitlabRoadmap,
	'gitlab-issues': GitlabIssues,
};

type Subject = CachedContent<{ name: string; description: string } | undefined>;

// A page reads these once, as only a page can answer not found, and a Source that is down should cost one timeout.
const subjectReaders: Partial<Record<ControllerName, (params: Record<string, string>) => Promise<Subject>>> = {
	'gitlab-group': ({ source, group }) => getGroup(getGitlabSource(source), group),
	'gitlab-project': ({ source, group, project }) => getProject(getGitlabSource(source), `${group}/${project}`),
	'gitlab-roadmap': ({ source, group }) => getMainGroup(getGitlabSource(source), group),
	'gitlab-issues': ({ source, group }) => getGroup(getGitlabSource(source), group),
};

const url = `/${Astro.params.path ?? ''}`;
const match = matchRoute(getSettings(), url);
if (!match) return new Response(null, { status: 404 });

const Controller = controllers[match.route.controller];
const { source, group, project } = match.params;
const subject = await subjectReaders[match.route.controller]?.(match.params);
if (subject && !subject.error && !subject.data) return new Response(null, { status: 404 });
---

{
	subject?.error ? (
		<Layout title={project ?? group}>
			<p role="alert">
				{project ?? group} could not be loaded from {source}.
			</p>
		</Layout>
	) : (
		<Controller {...match.params} title={subject?.data?.name} description={subject?.data?.description} />
	)
}

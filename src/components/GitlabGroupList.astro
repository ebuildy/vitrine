---
import { gitlabGroupUrl, gitlabIssuesUrl, gitlabRoadmapUrl } from '../router.ts';
import { getGitlabSource, getSettings } from '../settings.ts';
import { listMainGroups, listSubgroups } from '../sources/gitlab.ts';
import type { MainGroupList } from '../sources/gitlab.ts';

interface Props {
	source: string;
	/** The Group whose subgroups to list. Left out, it lists the Main Groups of the Source. */
	group?: string;
	/** Left empty, the page heads this list itself. */
	title?: string;
	maxItems?: number;
}

const { source, group, maxItems } = Astro.props;
const kind = group === undefined ? 'Main Groups' : 'Subgroups';
const { title = kind } = Astro.props;
const gitlabSource = getGitlabSource(source);
const { routes } = getSettings();
const { data: groups, stale, detailsMissing }: MainGroupList = await (group === undefined ? listMainGroups(gitlabSource) : listSubgroups(gitlabSource, group));
---

{stale && <p role="status">This list is Stale because {source} is down.</p>}
{detailsMissing && <p role="alert">Some Groups could not be loaded from {source}.</p>}
{!groups && <p role="alert">{kind} could not be loaded from {source}.</p>}
{
	groups && groups.length > 0 && (
		<section>
			{title && <h2>{title}</h2>}
			<ul>
				{groups.slice(0, maxItems).map((listed) => {
					const url = gitlabGroupUrl(routes, source, listed.path);
					const issuesUrl = gitlabIssuesUrl(routes, source, listed.path);
					const roadmapUrl = gitlabSource.mainGroups.includes(listed.path) ? gitlabRoadmapUrl(routes, source, listed.path) : undefined;
					return (
						<li>
							<h3>{url ? <a href={url}>{listed.name}</a> : listed.name}</h3>
							{listed.description && <p>{listed.description}</p>}
							<p>
								{listed.projectCount} {listed.projectCount === 1 ? 'Project' : 'Projects'}
							</p>
							<p class="links">
								{issuesUrl && <a href={issuesUrl}>Issues</a>}
								{roadmapUrl && <a href={roadmapUrl}>Roadmap</a>}
								<a href={listed.webUrl}>View in GitLab</a>
							</p>
						</li>
					);
				})}
			</ul>
		</section>
	)
}

<style>
	section {
		padding: 1rem;
	}

	h2 {
		margin: 0 0 0.75rem;
	}

	ul {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		position: relative;
		padding: 1rem;
		border: 1px solid #8884;
		border-radius: 0.5rem;
	}

	li:hover {
		border-color: currentColor;
	}

	h3 {
		margin: 0 0 0.75rem;
		font-size: 1.125rem;
		overflow-wrap: anywhere;
	}

	p {
		margin: 0 0 0.75rem;
	}

	/* Stretches the link over its card, so that a click anywhere opens the Group. */
	h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	/* Lifts these links above the one stretched over the card. */
	.links {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		gap: 0 1rem;
		margin: 0;
	}
</style>

---
import { getGitlabSource, gitlabGroupUrl } from '../settings.ts';
import { listSubgroups } from '../sources/gitlab.ts';

interface Props {
	source: string;
	group: string;
}

const { source, group } = Astro.props;
const { data: subgroups, stale } = await listSubgroups(getGitlabSource(source), group);
---

{stale && <p role="status">This list is Stale because {source} is down.</p>}
{!subgroups && <p role="alert">Subgroups could not be loaded from {source}.</p>}
{
	subgroups && subgroups.length > 0 && (
		<section>
			<h2>Subgroups</h2>
			<ul>
				{subgroups.map((subgroup) => {
					const url = gitlabGroupUrl(source, subgroup.path);
					return (
						<li>
							<h3>{url ? <a href={url}>{subgroup.name}</a> : subgroup.name}</h3>
							{subgroup.description && <p>{subgroup.description}</p>}
							<a class="source-link" href={subgroup.webUrl}>
								View in GitLab
							</a>
						</li>
					);
				})}
			</ul>
		</section>
	)
}

<style>
	section {
		padding: 1rem;
	}

	h2 {
		margin: 0 0 0.75rem;
	}

	ul {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		position: relative;
		padding: 1rem;
		border: 1px solid #8884;
		border-radius: 0.5rem;
	}

	li:hover {
		border-color: currentColor;
	}

	h3 {
		margin: 0 0 0.75rem;
		font-size: 1.125rem;
		overflow-wrap: anywhere;
	}

	/* Stretches the link over its card, so that a click anywhere opens the Group. */
	h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	/* Lifts the link to GitLab above the one stretched over the card. */
	.source-link {
		position: relative;
	}
</style>

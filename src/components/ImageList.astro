---
import { getHarborSource } from '../settings.ts';
import { listImages } from '../sources/harbor.ts';

interface Props {
	source: string;
	project: string;
}

const { source, project } = Astro.props;
const { data: images, stale } = await listImages(getHarborSource(source), project);
---

{stale && <p role="status">This list is Stale because {source} is down.</p>}
{
	!images ? (
		<p role="alert">Images could not be loaded because {source} is down.</p>
	) : images.length > 0 ? (
		<ul>
			{images.map((image) => (
				<li>{image.name}</li>
			))}
		</ul>
	) : (
		<p>No Images found.</p>
	)
}

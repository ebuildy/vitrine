---
import { readThrough } from '../content-cache.ts';
import { getHarborSource } from '../settings.ts';
import { listImages } from '../sources/harbor.ts';

interface Props {
	source: string;
	project: string;
}

const { source, project } = Astro.props;
const harbor = getHarborSource(source);
const { data: images, stale } = await readThrough(`${source}/images/${project}`, harbor.allowedAgeMinutes * 60_000, (signal) =>
	listImages(harbor, project, signal),
);
---

{stale && <p role="status">{source} is down, so this list may be out of date.</p>}
{
	!images ? (
		<p role="alert">Images could not be loaded because {source} is down.</p>
	) : images.length > 0 ? (
		<ul>
			{images.map((image) => (
				<li>{image.name}</li>
			))}
		</ul>
	) : (
		<p>No Images found.</p>
	)
}

---
import { getGitlabSource } from '../settings.ts';
import { listContributors } from '../sources/gitlab.ts';

interface Props {
	source: string;
	project: string;
}

const { source, project } = Astro.props;
const { data: contributors, stale } = await listContributors(getGitlabSource(source), project);
---

<section>
	<h2>Contributors</h2>
	{stale && <p role="status">This list is Stale because {source} is down.</p>}
	{
		!contributors ? (
			<p role="alert">Contributors could not be loaded from {source}.</p>
		) : contributors.length > 0 ? (
			<ul>
				{contributors.map((contributor) => (
					<li>
						{contributor.name}, {contributor.commits} {contributor.commits === 1 ? 'commit' : 'commits'}
					</li>
				))}
			</ul>
		) : (
			<p>No contributors found.</p>
		)
	}
</section>

<style>
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		padding: 0.25rem 0;
		overflow-wrap: anywhere;
	}
</style>

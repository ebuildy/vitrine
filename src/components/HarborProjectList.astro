---
import { formatDate, formatSize } from '../format.ts';
import { harborImagesUrl } from '../router.ts';
import { getHarborSource, getSettings } from '../settings.ts';
import { listProjects } from '../sources/harbor.ts';

interface Props {
	source: string;
	/** Left out, it shows every Harbor project the Source reports. */
	projects?: string[];
	maxItems?: number;
}

const { source, projects: selected, maxItems } = Astro.props;
const { data: reported, stale } = await listProjects(getHarborSource(source));
const projects = selected ? reported?.filter(({ name }) => selected.includes(name)) : reported;
---

{stale && <p role="status">This list is Stale because {source} is down.</p>}
{
	!projects ? (
		<p role="alert">Harbor projects could not be loaded because {source} is down.</p>
	) : projects.length > 0 ? (
		<ul>
			{projects.slice(0, maxItems).map((project) => {
				const url = harborImagesUrl(getSettings().routes, source, project.name);
				return (
					<li>
						<h2>{url ? <a href={url}>{project.name}</a> : project.name}</h2>
						<dl>
							<div>
								<dt>Repositories</dt>
								<dd>{project.repositoryCount}</dd>
							</div>
							<div>
								<dt>Created</dt>
								<dd>{formatDate(project.createdAt)}</dd>
							</div>
							{project.storageUsed !== undefined && (
								<div>
									<dt>Storage used</dt>
									<dd>{formatSize(project.storageUsed)}</dd>
								</div>
							)}
						</dl>
					</li>
				);
			})}
		</ul>
	) : (
		<p>No Harbor projects found.</p>
	)
}

<style>
	ul {
		display: grid;
		/* Four columns across the page, and fewer in a narrower place. */
		grid-template-columns: repeat(auto-fill, minmax(max(25% - 1rem, 12rem), 1fr));
		gap: 1rem;
		margin: 0;
		padding: 1rem;
		list-style: none;
	}

	li {
		position: relative;
		padding: 1rem;
		border: 1px solid #8884;
		border-radius: 0.5rem;
	}

	li:hover {
		border-color: currentColor;
	}

	h2 {
		margin: 0 0 0.75rem;
		font-size: 1.125rem;
		overflow-wrap: anywhere;
	}

	/* Stretches the link over its card, so that a click anywhere opens the Harbor project. */
	a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	dl {
		margin: 0;
	}

	dl div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	dd {
		margin: 0;
	}
</style>

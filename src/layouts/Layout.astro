---
import { matchRoute } from '../router.ts';
import { getSettings } from '../settings.ts';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
const settings = getSettings();
const { branding, navigation, theme } = settings;
const { siteName, logo } = branding;
const themeVariables = Object.fromEntries(Object.entries(theme).map(([name, colour]) => [`--color-${name}`, colour]));
// Not every installation has a Route at the root URL, and a link home should not lead to not found.
const hasHome = Boolean(matchRoute(settings, '/'));
const SiteNameTag = hasHome ? 'a' : 'span';
---

<!doctype html>
<html lang="en" style={themeVariables}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
	</head>
	<body>
		<header>
			<SiteNameTag class="site-name" href={hasHome ? '/' : undefined}>
				{logo && <img src={logo} alt="" />}
				{siteName}
			</SiteNameTag>
			{
				navigation.length > 0 && (
					<nav aria-label="Main">
						<ul>
							{navigation.map(({ label, url }) => (
								<li>
									<a href={url}>{label}</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</header>
		<slot />
	</body>
</html>

<style is:global>
	/* The defaults of the Theme. Settings override them on <html>, and Components and Templates read them. */
	:root {
		--color-primary: LinkText;
		--color-background: Canvas;
		--color-text: CanvasText;
		--color-border: #8884;
	}

	body {
		background: var(--color-background);
		color: var(--color-text);
	}

	a {
		color: var(--color-primary);
	}
</style>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 2rem;
		padding: 0.75rem 1rem;
	}

	.site-name {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: bold;
		text-decoration: none;
	}

	.site-name img {
		height: 2rem;
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>

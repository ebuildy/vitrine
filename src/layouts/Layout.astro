---
import { matchRoute, searchUrl } from '../router.ts';
import { getSettings } from '../settings.ts';
import '../themes/naval.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
const settings = getSettings();
const { branding, navigation, theme } = settings;
const { siteName, logo } = branding;
const { name: themeName, css, dark, ...light } = theme;
// Settings set each colour for one mode, and the stylesheet makes --color-<name> of the pair.
const themeVariables = Object.fromEntries([
	...Object.entries(light).map(([name, colour]) => [`--color-${name}-light`, colour]),
	...Object.entries(dark).map(([name, colour]) => [`--color-${name}-dark`, colour]),
]);
// Not every installation has a Route at the root URL, and a link home should not lead to not found.
const hasHome = Boolean(matchRoute(settings, '/'));
const SiteNameTag = hasHome ? 'a' : 'span';
// The search page has a box of its own, which a second one would only repeat.
const search = searchUrl(settings.routes);
const showsSearchBox = search !== undefined && search !== Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme={themeName} style={themeVariables}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{/* Before the page paints, so that a Visitor who picked a mode never sees the other one flash. */}
		<script is:inline>
			try {
				const mode = localStorage.getItem('vitrine-color-mode');
				if (mode === 'light' || mode === 'dark') document.documentElement.dataset.colorMode = mode;
			} catch {}
		</script>
	</head>
	<body>
		{/* Astro adds its own styles at the end of <head>, and the CSS of Settings must come after them to win. */}
		{css.map((stylesheet) => ('href' in stylesheet ? <link rel="stylesheet" href={stylesheet.href} /> : <style is:inline set:html={stylesheet.code} />))}
		<header class="site-header">
			<SiteNameTag class="site-name" href={hasHome ? '/' : undefined}>
				{logo && <img src={logo} alt="" />}
				{siteName}
			</SiteNameTag>
			{
				navigation.length > 0 && (
					<nav aria-label="Main">
						<ul>
							{navigation.map(({ label, url }) => (
								<li>
									<a href={url} aria-current={url === Astro.url.pathname ? 'page' : undefined}>{label}</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
			{
				showsSearchBox && (
					<form class="site-search" action={search} method="get" role="search">
						<input type="search" name="q" aria-label="Search Vitrine" placeholder="Search" />
					</form>
				)
			}
			{/* Without JavaScript, the page follows the system, and a menu that does nothing stays hidden. */}
			<select class="color-mode" aria-label="Colour mode" hidden>
				<option value="system">System</option>
				<option value="light">Light</option>
				<option value="dark">Dark</option>
			</select>
		</header>
		<slot />
		{
			themeName === 'naval' && (
				<div class="sea" aria-hidden="true">
					<span class="vessel boat sailboat" />
					<span class="vessel submarine" />
					<span class="vessel boat tugboat" />
					<span class="vessel submarine" />
				</div>
			)
		}
	</body>
</html>

<script>
	const menu = document.querySelector<HTMLSelectElement>('select.color-mode');
	if (menu) {
		const root = document.documentElement;
		menu.value = root.dataset.colorMode ?? 'system';
		menu.hidden = false;
		menu.addEventListener('change', () => {
			const mode = menu.value;
			if (mode === 'light' || mode === 'dark') root.dataset.colorMode = mode;
			else delete root.dataset.colorMode;
			try {
				if (mode === 'light' || mode === 'dark') localStorage.setItem('vitrine-color-mode', mode);
				else localStorage.removeItem('vitrine-color-mode');
			} catch {
				// A browser that refuses storage still switches, for this page.
			}
		});
	}
</script>

<style is:global>
	/*
	 * The defaults of the Theme, as one colour for each mode. A named Theme and then Settings override them on <html>,
	 * and Components and Templates read --color-<name>, which is the colour of the current mode.
	 */
	:root {
		/* The system picks the mode, unless the Visitor picked one. */
		color-scheme: light dark;
		--color-primary-light: LinkText;
		--color-primary-dark: LinkText;
		--color-background-light: Canvas;
		--color-background-dark: Canvas;
		--color-text-light: CanvasText;
		--color-text-dark: CanvasText;
		--color-border-light: #8884;
		--color-border-dark: #8884;
		--color-primary: light-dark(var(--color-primary-light), var(--color-primary-dark));
		--color-background: light-dark(var(--color-background-light), var(--color-background-dark));
		--color-text: light-dark(var(--color-text-light), var(--color-text-dark));
		--color-border: light-dark(var(--color-border-light), var(--color-border-dark));
	}

	:root[data-color-mode='light'] {
		color-scheme: light;
	}

	:root[data-color-mode='dark'] {
		color-scheme: dark;
	}

	body {
		background: var(--color-background);
		color: var(--color-text);
	}

	a {
		color: var(--color-primary);
	}
</style>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 2rem;
		padding: 0.75rem 1rem;
	}

	.site-name {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: bold;
		text-decoration: none;
	}

	.site-name img {
		height: 2rem;
	}

	.site-search {
		margin-left: auto;
	}

	.site-search input {
		padding: 0.3rem 0.6rem;
		font: inherit;
	}

	.site-search + .color-mode {
		margin-left: 0;
	}

	.color-mode {
		margin-left: auto;
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>

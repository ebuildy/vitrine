---
import GitlabCommitList from '../components/GitlabCommitList.astro';
import GitlabContributorList from '../components/GitlabContributorList.astro';
import GitlabProjectIssues from '../components/GitlabProjectIssues.astro';
import GitlabProjectSummary from '../components/GitlabProjectSummary.astro';
import GitlabReadme from '../components/GitlabReadme.astro';
import GitlabReleaseList from '../components/GitlabReleaseList.astro';
import Arrangement from '../layouts/Arrangement.astro';
import Layout from '../layouts/Layout.astro';
import type { CompiledTemplate } from '../template-compiler.ts';

interface Props {
	source: string;
	group: string;
	project: string;
	title: string;
	description: string;
	template?: CompiledTemplate;
}

const { source, group, project, title, description, template } = Astro.props;
const path = `${group}/${project}`;
---

<Layout title={title} description={description}>
	<Arrangement template={template} source={source} group={group} project={project} path={path} title={title} description={description}>
		<GitlabProjectSummary source={source} project={path} />
		<div class="columns">
			<main>
				<GitlabReadme source={source} project={path} />
				<GitlabCommitList source={source} project={path} />
				<GitlabProjectIssues source={source} project={path} />
			</main>
			<aside>
				<GitlabReleaseList source={source} project={path} />
				<GitlabContributorList source={source} project={path} />
			</aside>
		</div>
	</Arrangement>
</Layout>

<script>
	// Each part of the main column folds under its title. Without JavaScript, every part stays open.
	const chevron = '<svg class="chevron" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6l4 4 4-4"/></svg>';
	for (const [index, heading] of [...document.querySelectorAll<HTMLHeadingElement>('.columns > main > section > h2')].entries()) {
		const body = heading.nextElementSibling;
		if (!(body instanceof HTMLElement)) continue;
		body.id ||= `fold-${index}`;

		const button = document.createElement('button');
		button.type = 'button';
		button.setAttribute('aria-expanded', 'true');
		button.setAttribute('aria-controls', body.id);
		button.append(...heading.childNodes);
		button.insertAdjacentHTML('beforeend', chevron);
		heading.append(button);
		button.addEventListener('click', () => {
			const open = button.getAttribute('aria-expanded') !== 'true';
			button.setAttribute('aria-expanded', String(open));
			body.hidden = !open;
		});
	}
</script>

<style>
	/* The folding title: its button spans the whole heading, with a chevron at the right that points down when the part is open. */
	.columns :global(main > section > h2) {
		position: relative;
	}

	.columns :global(main > section > h2 > button) {
		display: flex;
		flex: 1;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		width: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		letter-spacing: inherit;
		text-align: left;
		cursor: pointer;
	}

	.columns :global(main > section > h2 > button::after) {
		content: '';
		position: absolute;
		inset: 0;
	}

	.columns :global(.chevron) {
		flex: none;
		width: 1rem;
		height: 1rem;
		transition: rotate 0.2s ease;
	}

	.columns :global([aria-expanded='false'] > .chevron) {
		rotate: -90deg;
	}

	@media (prefers-reduced-motion: reduce) {
		.columns :global(.chevron) {
			transition: none;
		}
	}

	.columns {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 20rem;
		gap: 2rem;
		padding: 0 1rem 1rem;
	}

	@media (max-width: 48rem) {
		.columns {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

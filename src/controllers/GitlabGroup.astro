---
import GitlabGroupList from '../components/GitlabGroupList.astro';
import GitlabGroupSummary from '../components/GitlabGroupSummary.astro';
import GitlabProjectList from '../components/GitlabProjectList.astro';
import GroupMembers from '../components/GroupMembers.astro';
import Arrangement from '../layouts/Arrangement.astro';
import Layout from '../layouts/Layout.astro';
import type { CompiledTemplate } from '../template-compiler.ts';

interface Props {
	source: string;
	group: string;
	title: string;
	description: string;
	template?: CompiledTemplate;
}

const { source, group, title, description, template } = Astro.props;
---

<Layout title={title} description={description}>
	<Arrangement template={template} source={source} group={group} title={title} description={description}>
		<GitlabGroupSummary source={source} group={group} />
		<GitlabGroupList source={source} group={group} />
		<GitlabProjectList source={source} group={group} />
		<GroupMembers source={source} group={group} />
	</Arrangement>
</Layout>

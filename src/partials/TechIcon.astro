---
import type { Icon } from '../icons.ts';

interface Props {
	/** Left out, nothing is rendered, so a title without a known technology keeps its layout. */
	icon?: Icon;
}

const { icon } = Astro.props;
---

{icon && <img class="tech-icon" src={icon.url} alt="" aria-hidden="true" width="20" height="20" />}

<style>
	.tech-icon {
		width: 1.25rem;
		height: 1.25rem;
		margin-right: 0.4em;
		vertical-align: -0.2em;
	}
</style>
